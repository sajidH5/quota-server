# Copy to .env for `npm run dev`.
# Brevo API key: Brevo > SMTP & API > API keys. BREVO_API_KEY=log prints emails instead of sending.
BREVO_API_KEY=
# Where quote requests go (comma separated). Change before going live.
QUOTE_TO=
# Sender: must be a verified sender in Brevo.
QUOTE_FROM=
QUOTE_FROM_NAME=Braintree Scientific
# Shops allowed to post the form (comma separated, no trailing slash).
ALLOWED_ORIGINS=https://www.braintreesci.com,https://braintreesci.com,https://braintree-staging.mybigcommerce.com,https://store-z0gr7jrd1j.mybigcommerce.com,https://store-ye27j2homb.mybigcommerce.com,http://localhost:3000,http://localhost:5001
# "true" also emails the shopper a copy of the PDF.
SEND_CONFIRMATION=true
